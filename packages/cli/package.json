{
  "name": "persianlabsui",
  "version": "0.1.0",
  "description": "Scaffold and theme RTL-first, Persian-typography shadcn projects - init from a /create preset, add components from the Persian Labs registry.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "persianlabsui": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./preset": "./src/preset/preset.ts"
  },
  "files": [
    "dist",
    "templates",
    "src/preset"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-templates": "bun run scripts/sync-templates.mjs",
    "prepack": "bun run typecheck && bun run test && bun run build && bun run sync-templates"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/persianlabs/ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ui.persian-labs.ir",
  "bugs": {
    "url": "https://github.com/persianlabs/ui/issues"
  },
  "keywords": [
    "shadcn",
    "tailwind",
    "rtl",
    "persian",
    "farsi",
    "components",
    "registry",
    "cli"
  ]
}
