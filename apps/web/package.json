{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "bun scripts/generate-example-map.mts && bun scripts/generate-preview-map.mts",
    "prebuild": "bun scripts/generate-example-map.mts && bun scripts/generate-preview-map.mts && shadcn build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "bunx --package @typescript/native tsc --noEmit",
    "registry:build": "shadcn build",
    "update": "npx npm-check-updates -u"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/persian": "^10.0.1",
    "@ncdai/react-wheel-picker": "^1.2.2",
    "@tanstack/react-table": "^9.1.2",
    "@vercel/analytics": "^2.0.1",
    "@workspace/ui": "workspace:*",
    "embla-carousel-autoplay": "^8.6.0",
    "fumadocs-core": "^16.15.0",
    "fumadocs-docgen": "^3.1.0",
    "fumadocs-mdx": "^15.3.1",
    "input-otp": "^1.5.0",
    "lucide": "^1.33.0",
    "lucide-react": "^1.33.0",
    "morphicons": "^1.7.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-textarea-autosize": "^8.5.9",
    "rehype-pretty-code": "^0.14.5",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.1",
    "shadcn": "^4.19.0",
    "typescript": "^6.0.2"
  }
}
