      "content": "import { normalizePersianDigits } from \"@/lib/normalize-persian-digits\"\n\n/**\n * 3-digit issuance-office prefixes assigned by Iran's National Organization\n * for Civil Registration. Used only when `checkPrefix` is enabled — a code\n * whose prefix isn't in this list either predates it or was issued after it\n * was last updated, so this check trades a few false negatives for catching\n * obviously malformed-but-checksum-valid values.\n */\nconst VALID_NATIONAL_ID_PREFIXES: ReadonlySet<string> = new Set([\n  \"001\",\n  \"002\",\n  \"003\",\n  \"004\",\n  \"005\",\n  \"006\",\n  \"007\",\n  \"008\",\n  \"011\",\n  \"015\",\n  \"020\",\n  \"025\",\n  \"031\",\n  \"032\",\n  \"037\",\n  \"038\",\n  \"041\",\n  \"042\",\n  \"043\",\n  \"044\",\n  \"045\",\n  \"048\",\n  \"049\",\n  \"051\",\n  \"052\",\n  \"053\",\n  \"055\",\n  \"056\",\n  \"057\",\n  \"058\",\n  \"059\",\n  \"060\",\n  \"061\",\n  \"062\",\n  \"063\",\n  \"064\",\n  \"065\",\n  \"067\",\n  \"068\",\n  \"069\",\n  \"070\",\n  \"072\",\n  \"073\",\n  \"074\",\n  \"075\",\n  \"076\",\n  \"077\",\n  \"078\",\n  \"079\",\n  \"081\",\n  \"082\",\n  \"083\",\n  \"084\",\n  \"085\",\n  \"086\",\n  \"087\",\n  \"088\",\n  \"089\",\n  \"090\",\n  \"091\",\n  \"092\",\n  \"093\",\n  \"094\",\n  \"096\",\n  \"097\",\n  \"098\",\n  \"105\",\n  \"106\",\n  \"108\",\n  \"109\",\n  \"110\",\n  \"111\",\n  \"112\",\n  \"113\",\n  \"114\",\n  \"115\",\n  \"116\",\n  \"117\",\n  \"118\",\n  \"119\",\n  \"120\",\n  \"121\",\n  \"122\",\n  \"123\",\n  \"124\",\n  \"125\",\n  \"126\",\n  \"127\",\n  \"128\",\n  \"129\",\n  \"136\",\n  \"137\",\n  \"138\",\n  \"145\",\n  \"146\",\n  \"149\",\n  \"150\",\n  \"152\",\n  \"153\",\n  \"154\",\n  \"155\",\n  \"157\",\n  \"158\",\n  \"159\",\n  \"160\",\n  \"161\",\n  \"162\",\n  \"163\",\n  \"164\",\n  \"165\",\n  \"166\",\n  \"167\",\n  \"168\",\n  \"169\",\n  \"170\",\n  \"171\",\n  \"172\",\n  \"173\",\n  \"174\",\n  \"175\",\n  \"181\",\n  \"182\",\n  