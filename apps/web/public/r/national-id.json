\n  \"375\",\n  \"376\",\n  \"377\",\n  \"378\",\n  \"379\",\n  \"380\",\n  \"381\",\n  \"382\",\n  \"383\",\n  \"384\",\n  \"385\",\n  \"386\",\n  \"387\",\n  \"392\",\n  \"393\",\n  \"394\",\n  \"395\",\n  \"396\",\n  \"397\",\n  \"398\",\n  \"399\",\n  \"400\",\n  \"401\",\n  \"402\",\n  \"403\",\n  \"404\",\n  \"405\",\n  \"406\",\n  \"407\",\n  \"412\",\n  \"413\",\n  \"416\",\n  \"417\",\n  \"418\",\n  \"419\",\n  \"420\",\n  \"421\",\n  \"422\",\n  \"423\",\n  \"424\",\n  \"425\",\n  \"426\",\n  \"427\",\n  \"428\",\n  \"431\",\n  \"432\",\n  \"436\",\n  \"437\",\n  \"438\",\n  \"439\",\n  \"440\",\n  \"441\",\n  \"442\",\n  \"443\",\n  \"444\",\n  \"445\",\n  \"446\",\n  \"447\",\n  \"448\",\n  \"449\",\n  \"450\",\n  \"451\",\n  \"452\",\n  \"453\",\n  \"454\",\n  \"455\",\n  \"456\",\n  \"457\",\n  \"458\",\n  \"459\",\n  \"460\",\n  \"461\",\n  \"462\",\n  \"464\",\n  \"465\",\n  \"466\",\n  \"467\",\n  \"468\",\n  \"469\",\n  \"470\",\n  \"471\",\n  \"472\",\n  \"481\",\n  \"482\",\n  \"483\",\n  \"484\",\n  \"485\",\n  \"486\",\n  \"487\",\n  \"488\",\n  \"489\",\n  \"490\",\n  \"491\",\n  \"492\",\n  \"493\",\n  \"494\",\n  \"495\",\n  \"496\",\n  \"497\",\n  \"498\",\n  \"499\",\n  \"500\",\n  \"501\",\n  \"502\",\n  \"503\",\n  \"504\",\n  \"505\",\n  \"506\",\n  \"507\",\n  \"508\",\n  \"509\",\n  \"510\",\n  \"511\",\n  \"512\",\n  \"513\",\n  \"514\",\n  \"515\",\n  \"516\",\n  \"517\",\n  \"518\",\n  \"519\",\n  \"520\",\n  \"521\",\n  \"522\",\n  \"523\",\n  \"524\",\n  \"525\",\n  \"526\",\n  \"527\",\n  \"528\",\n  \"529\",\n  \"530\",\n  \"531\",\n  \"532\",\n  \"533\",\n  \"534\",\n  \"535\",\n  \"536\",\n  \"537\",\n  \"538\",\n  \"539\",\n  \"540\",\n  \"541\",\n  \"542\",\n  \"543\",\n  \"544\",\n  \"545\",\n  \"546\",\n  \"547\",\n  \"548\",\n  \"549\",\n  \"550\",\n  \"551\",\n  \"552\",\n  \"553\",\n  \"554\",\n  \"555\",\n  \"556\",\n  \"557\",\n  \"558\",\n  \"559\",\n  \"560\",\n  \"561\",\n  \"562\",\n  \"563\",\n  \"564\",\n  \"565\",\n  \"566\",\n  \"567\",\n  \"568\",\n  \"569\",\n  \"570\",\n  \"571\",\n  \"572\",\n  \"573\",\n  \"574\",\n  \"575\",\n  \"576\",\n  \"577\",\n  \"578\",\n  \"579\",\n  \"580\",\n  \"581\",\n  \"582\",\n  \"583\",\n  \"584\",\n  \"585\",\n  \"586\",\n  \"587\",\n  \"588\",\n  \"589\",\n  \"590\",\n  \"591\",\n  \"592\",\n  \"593\",\n  \"594\",\n  \"595\",\n  \"596\",\n  \"597\",\n  \"598\",\n  \"599\",\n  \"600\",\n  \"601\",\n  \"602\",\n  \"603\",\n  \"604\",\n  \"605\",\n  \"606\",\n  \"607\",\n  \"608\",\n  \"609\",\n  \"610\",\n  \"611\",\n  \"612\",\n  \"613\",\n  \"614\",\n  \"615\",\n  \"616\",\n  \"617\",\n  \"618\",\n  \"619\",\n  \"620\",\n  \"621\",\n  \"622\",\n  \"623\",\n  \"624\",\n  \"625\",\n  \"626\",\n  \"627\",\n  \"628\",\n  \"629\",\n  \"630\",\n  \"631\",\n  \"632\",\n  \"633\",\n  \"634\",\n  \"635\",\n  \"636\",\n  \"637\",\n  \"638\",\n  \"639\",\n  \"640\",\n  \"641\",\n  \"642\",\n  \"643\",\n  \"644\",\n  \"645\",\n  \"646\",\n  \"647\",\n  \"648\",\n  \"649\",\n  \"650\",\n  \"651\",\n  \"652\",\n  \"653\",\n  \"654\",\n  \"655\",\n  \"656\",\n  \"657\",\n  \"658\",\n  \"659\",\n  \"660\",\n  \"661\",\n  \"662\",\n  \"663\",\n  \"664\",\n  \"665\",\n  \"666\",\n  \"667\",\n  \"668\",\n  \"669\",\n  \"670\",\n  \"671\",\n  \"672\",\n  \"673\",\n  \"674\",\n  \"675\",\n  \"676\",\n  \"677\",\n  \"678\",\n  \"679\",\n  \"680\",\n  \"681\",\n  \"682\",\n  \"683\",\n  \"684\",\n  \"685\",\n  \"686\",\n  \"687\",\n  \"688\",\n  \"689\",\n  \"690\",\n  \"691\",\n  \"692\",\n  \"693\",\n  \"694\",\n  \"695\",\n  \"696\",\n  \"697\",\n  \"698\",\n  \"699\",\n  \"700\",\n  \"701\",\n  \"702\",\n  \"703\",\n  \"704\",\n  \"705\",\n  \"706\",\n  \"707\",\n  \"708\",\n  \"709\",\n  \"710\",\n  \"711\",\n  \"712\",\n  \"713\",\n  \"714\",\n  \"715\",\n  \"716\",\n  \"717\",\n  \"718\",\n  \"719\",\n  \"720\",\n  \"721\",\n  \"722\",\n  \"723\",\n  \"724\",\n  \"725\",\n  \"726\",\n  \"727\",\n  \"728\",\n  \"729\",\n  \"730\",\n  \"731\",\n  \"732\",\n  \"775\",\n  \"778\",\n  \"986\",\n])\n\nexport interface IsValidNationalIdOptions {\n  /**\n   * Also verify the first 3 digits against the known issuance-office prefix\n   * list. Rejects malformed-but-checksum-valid values, at the cost of a\n   * false negative on any prefix issued after this list was last updated —\n   * pass `false` if you'd rather skip that risk and rely on the checksum\n   * alone.\n   *\n   * @default true\n   */\n  checkPrefix?: boolean\n}\n\n/**\n * Validates an Iranian national ID (کد ملی).\n *\n * - Accepts 8-10 digit input; shorter values are zero-padded on the left,\n *   matching systems that store the code without leading zeros.\n * - Rejects an all-zero value and any repeated-digit sequence (e.g.\n *   \"1111111111\").\n * - Rejects a value whose 6 middle digits (positions 4-9) are all zero.\n * - Verifies the 10th digit against the standard weighted checksum: each of\n *   the first 9 digits is weighted by (10 - index), the weighted sum is\n *   taken mod 11, and the result must match the check digit — with the\n *   well-known edge case that a remainder under 2 expects the check digit\n *   to equal the remainder itself, rather than 11 - remainder.\n * - By default, also verifies the 3-digit prefix against known\n *   issuance-office codes (see `checkPrefix`).\n *\n * @example\n * isValidNationalId(\"0499370899\") // true\n * isValidNationalId(\"499370899\") // true — zero-padded to \"0499370899\"\n * isValidNationalId(\"۰۴۹۹۳۷۰۸۹۹\") // true — Persian digits normalized first\n * isValidNationalId(\"0000000000\") // false — all zeros\n * isValidNationalId(\"1111111111\") // false — repeated digits\n * isValidNationalId(\"0499370898\") // false — bad checksum\n */\nexport function isValidNationalId(\n  value: string | null | undefined,\n  options: IsValidNationalIdOptions = {}\n): boolean {\n  const { checkPrefix = true } = options\n  const digits = normalizePersianDigits(value ?? \"\").replace(/\\D/g, \"\")\n\n  if (digits.length < 8 || digits.length > 10) return false\n  if (Number(digits) === 0) return false\n\n  const padded = digits.padStart(10, \"0\")\n\n  if (/^(\\d)\\1{9}$/.test(padded)) return false\n  if (Number(padded.slice(3, 9)) === 0) return false\n  if (checkPrefix && !VALID_NATIONAL_ID_PREFIXES.has(padded.slice(0, 3))) {\n    return false\n  }\n\n  const check = Number(padded[9])\n  const sum = padded\n    .slice(0, 9)\n    .split(\"\")\n    .reduce((total, digit, index) => total + Number(digit) * (10 - index), 0)\n  const remainder = sum % 11\n\n  return remainder < 2 ? check === remainder : check === 11 - remainder\n}\n",
      "type": "registry:lib"
    }
