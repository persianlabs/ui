{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "persianlabsui",
  "homepage": "https://ui.persian-labs.ir",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A button built on Base UI with variant and size support.",
      "registryDependencies": ["utils"],
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "files": [
        {
          "path": "registry/base/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "tabs",
      "type": "registry:ui",
      "title": "Tabs",
      "description": "An accessible, animated tabs component built on Base UI with a spring-animated sliding active-tab indicator.",
      "registryDependencies": ["utils"],
      "dependencies": ["@base-ui/react", "motion"],
      "files": [
        {
          "path": "registry/base/ui/tabs.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "A styled text input built on Base UI.",
      "registryDependencies": ["utils"],
      "dependencies": ["@base-ui/react"],
      "files": [
        {
          "path": "registry/base/ui/input.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "label",
      "type": "registry:ui",
      "title": "Label",
      "description": "An accessible, styled label element.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/base/ui/label.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "scroll-area",
      "type": "registry:ui",
      "title": "Scroll Area",
      "description": "Cross-browser custom scrollbars, built on Base UI.",
      "registryDependencies": ["utils"],
      "dependencies": ["@base-ui/react"],
      "files": [
        {
          "path": "registry/base/ui/scroll-area.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "combobox",
      "type": "registry:ui",
      "title": "Combobox",
      "description": "A searchable, accessible combobox built on Base UI.",
      "registryDependencies": ["utils", "@persianlabsui/scroll-area"],
      "dependencies": ["@base-ui/react"],
      "files": [
        {
          "path": "registry/base/ui/combobox.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "city-selector",
      "type": "registry:ui",
      "title": "City Selector",
      "description": "A province and city picker for Iran, built on Combobox and bundled with a full dataset of all 31 provinces and 1,119 cities.",
      "registryDependencies": ["utils", "@persianlabsui/combobox"],
      "dependencies": ["@base-ui/react"],
      "files": [
        {
          "path": "registry/base/ui/city-selector.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/base/lib/persian-provinces.ts",
          "type": "registry:lib"
        }
      ]
    }
  ]
}
